+      <input type="password" id="passwordInput" class="form-input" placeholder="请输入管理员密码">
+      <button id="loginBtn" class="btn btn-primary">登录</button>
+      <p id="loginError" class="error-message" style="display: none;"></p>
+    </div>
+  </div>
