+              <th>投票人</th>
+              <th>所属部门</th>
+              <th>投给部门</th>
+              <th>投票时间</th>
+            </tr>
+          </thead>
+          <tbody id="detailsBody">
+            <tr><td colspan="5">暂无数据</td></tr>
+          </tbody>
+        </table>
+      </div>
+    </section>
+  </div>
+
+  <script src="/js/admin.js"></script>
