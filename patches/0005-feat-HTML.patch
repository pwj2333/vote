+  <div id="adminPanel" class="admin-panel" style="display: none;">
+    <header class="admin-header">
+      <h1>部门评选投票 - 后台管理</h1>
+    </header>
+
+    <div class="control-panel">
+      <div class="control-item">
+        <button id="toggleVotingBtn" class="btn btn-toggle">
+          <span id="votingStatus">加载中...</span>
+        </button>
+      </div>
+      <div class="control-item">
+        <button id="resetBtn" class="btn btn-danger">重置所有数据</button>
+      </div>
+      <div class="control-item">
+        <button id="exportBtn" class="btn btn-success">导出 Excel</button>
+      </div>
+    </div>
+
+    <div class="stats-panel">
+      <div class="stat-card">
+        <div class="stat-label">总投票人数</div>
+        <div class="stat-value" id="totalVoters">0</div>
+      </div>
+      <div class="stat-card">
+        <div class="stat-label">总票数</div>
+        <div class="stat-value" id="totalVotes">0</div>
+      </div>
+    </div>
+
+    <section class="section">
+      <h2>实时排名</h2>
+      <table class="ranking-table">
+        <thead>
+          <tr>
+            <th>排名</th>
+            <th>部门名称</th>
+            <th>得票数</th>
+            <th>占比</th>
+          </tr>
+        </thead>
+        <tbody id="rankingBody">
+          <tr><td colspan="4">加载中...</td></tr>
+        </tbody>
+      </table>
+    </section>
+
+    <section class="section">
+      <h2>
+        <button id="toggleDetailsBtn" class="btn-link">查看投票记录</button>
+      </h2>
+      <div id="detailsPanel" style="display: none;">
+        <table class="details-table">
+          <thead>
+            <tr>
