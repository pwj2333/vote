index 0000000..43987c4
--- /dev/null
+++ b/README.md
@@ -0,0 +1,30 @@
+# 部门评选投票系统
+
+## 安装
+
+```bash
+npm install
+```
+
+## 配置
+
+复制 .env.example 到 .env 并修改密码：
+```bash
+copy .env.example .env
+```
+
+## 启动
+
+```bash
+npm start
+```
+
+## 访问
+
+- 投票页：http://localhost:3000
+- 后台管理：http://localhost:3000/admin
+- 二维码：http://localhost:3000/qr
+
+## 端口映射
+
+在路由器配置端口转发，将外部端口映射到本机 3000 端口。
diff --git a/package.json b/package.json
new file mode 100644
index 0000000..9c9a995
--- /dev/null
+++ b/package.json
@@ -0,0 +1,21 @@
+{
+  "name": "voting-system",
+  "version": "1.0.0",
+  "description": "部门评选投票系统",
+  "main": "server.js",
+  "scripts": {
+    "start": "node server.js",
+    "dev": "node server.js"
+  },
+  "dependencies": {
+    "express": "^4.18.2",
+    "sql.js": "^1.8.0",
+    "qrcode": "^1.5.3",
+    "express-session": "^1.17.3",
+    "exceljs": "^4.3.0",
+    "dotenv": "^16.0.3"
+  },
+  "engines": {
+    "node": ">=16.0.0"
+  }
+}
